{
  "name": "Sanctuary metrics: weekly pull to Sheet",
  "flow": [
    {
      "id": 1,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "graph_version",
            "value": "v25.0"
          },
          {
            "name": "fb_page_id",
            "value": "100063738294812"
          },
          {
            "name": "ig_user_id",
            "value": "SET_ME_IG_BUSINESS_ACCOUNT_ID"
          },
          {
            "name": "ga4_property_id",
            "value": "SET_ME_GA4_PROPERTY_ID"
          },
          {
            "name": "run_date",
            "value": "{{formatDate(now; \"YYYY-MM-DD\"; \"America/Phoenix\")}}"
          },
          {
            "name": "window_end",
            "value": "{{formatDate(addDays(now; -1); \"YYYY-MM-DD\"; \"America/Phoenix\")}}"
          },
          {
            "name": "window_start",
            "value": "{{formatDate(addDays(now; -28); \"YYYY-MM-DD\"; \"America/Phoenix\")}}"
          },
          {
            "name": "window_start_14",
            "value": "{{formatDate(addDays(now; -14); \"YYYY-MM-DD\"; \"America/Phoenix\")}}"
          },
          {
            "name": "ig_since",
            "value": "{{formatDate(parseDate(formatDate(addDays(now; -28); \"YYYY-MM-DD\"; \"America/Phoenix\"); \"YYYY-MM-DD\"; \"America/Los_Angeles\"); \"X\")}}"
          },
          {
            "name": "ig_until",
            "value": "{{formatDate(parseDate(formatDate(now; \"YYYY-MM-DD\"; \"America/Phoenix\"); \"YYYY-MM-DD\"; \"America/Los_Angeles\"); \"X\")}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Config + 28-day window"
        }
      }
    },
    {
      "id": 2,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "apiKey"
      },
      "mapper": {
        "url": "https://graph.facebook.com/{{1.graph_version}}/{{1.fb_page_id}}",
        "method": "get",
        "queryParameters": [
          {
            "name": "fields",
            "value": "id,name,followers_count,instagram_business_account{id,username}"
          }
        ],
        "contentType": "",
        "parseResponse": true,
        "stopOnHttpError": true
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "FB Page identity (scope guard)"
        }
      }
    },
    {
      "id": 3,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "apiKey"
      },
      "mapper": {
        "url": "https://graph.facebook.com/{{1.graph_version}}/{{1.fb_page_id}}/insights",
        "method": "get",
        "queryParameters": [
          {
            "name": "metric",
            "value": "page_media_view,page_total_media_view_unique,page_post_engagements,page_daily_follows_unique,page_daily_unfollows_unique,page_total_actions,page_views_total"
          },
          {
            "name": "period",
            "value": "days_28"
          },
          {
            "name": "since",
            "value": "{{1.window_end}}"
          },
          {
            "name": "until",
            "value": "{{1.run_date}}"
          }
        ],
        "contentType": "",
        "parseResponse": true,
        "stopOnHttpError": true
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "FB Page insights (28d)"
        }
      },
      "filter": {
        "name": "Sanctuary only (Page + linked IG must match config)",
        "conditions": [
          [
            {
              "a": "{{2.data.id}}",
              "o": "text:equal",
              "b": "{{1.fb_page_id}}"
            },
            {
              "a": "{{2.data.instagram_business_account.id}}",
              "o": "text:equal",
              "b": "{{1.ig_user_id}}"
            }
          ]
        ]
      }
    },
    {
      "id": 4,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "apiKey"
      },
      "mapper": {
        "url": "https://graph.facebook.com/{{1.graph_version}}/{{1.ig_user_id}}",
        "method": "get",
        "queryParameters": [
          {
            "name": "fields",
            "value": "id,username,followers_count,media_count"
          }
        ],
        "contentType": "",
        "parseResponse": true,
        "stopOnHttpError": true
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "IG account fields"
        }
      }
    },
    {
      "id": 5,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "apiKey"
      },
      "mapper": {
        "url": "https://graph.facebook.com/{{1.graph_version}}/{{1.ig_user_id}}/insights",
        "method": "get",
        "queryParameters": [
          {
            "name": "metric",
            "value": "views,reach,accounts_engaged,total_interactions,profile_links_taps"
          },
          {
            "name": "metric_type",
            "value": "total_value"
          },
          {
            "name": "period",
            "value": "day"
          },
          {
            "name": "since",
            "value": "{{1.ig_since}}"
          },
          {
            "name": "until",
            "value": "{{1.ig_until}}"
          }
        ],
        "contentType": "",
        "parseResponse": true,
        "stopOnHttpError": true
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "IG insights (28d total_value)"
        }
      }
    },
    {
      "id": 6,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "apiKey"
      },
      "mapper": {
        "url": "https://graph.facebook.com/{{1.graph_version}}/{{1.ig_user_id}}/media",
        "method": "get",
        "queryParameters": [
          {
            "name": "fields",
            "value": "id,timestamp,media_type"
          },
          {
            "name": "since",
            "value": "{{1.ig_since}}"
          },
          {
            "name": "until",
            "value": "{{1.ig_until}}"
          },
          {
            "name": "limit",
            "value": "100"
          }
        ],
        "contentType": "",
        "parseResponse": true,
        "stopOnHttpError": true
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0,
          "name": "IG posts published in window"
        }
      }
    },
    {
      "id": 7,
      "module": "google-analytics-4:makeAnApiCall",
      "version": 1,
      "parameters": {},
      "mapper": {
        "baseURL": "https://analyticsdata.googleapis.com/v1beta",
        "url": "/properties/{{1.ga4_property_id}}:batchRunReports",
        "method": "POST",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\n \"requests\": [\n  {\n   \"dateRanges\": [\n    {\n     \"startDate\": \"{{1.window_start}}\",\n     \"endDate\": \"{{1.window_end}}\"\n    }\n   ],\n   \"metrics\": [\n    {\n     \"name\": \"sessions\"\n    },\n    {\n     \"name\": \"totalUsers\"\n    },\n    {\n     \"name\": \"screenPageViews\"\n    },\n    {\n     \"name\": \"engagementRate\"\n    },\n    {\n     \"name\": \"averageSessionDuration\"\n    },\n    {\n     \"name\": \"keyEvents\"\n    }\n   ]\n  },\n  {\n   \"dateRanges\": [\n    {\n     \"startDate\": \"{{1.window_start_14}}\",\n     \"endDate\": \"{{1.window_end}}\"\n    }\n   ],\n   \"metrics\": [\n    {\n     \"name\": \"sessions\"\n    },\n    {\n     \"name\": \"totalUsers\"\n    },\n    {\n     \"name\": \"screenPageViews\"\n    },\n    {\n     \"name\": \"engagementRate\"\n    },\n    {\n     \"name\": \"averageSessionDuration\"\n    },\n    {\n     \"name\": \"keyEvents\"\n    }\n   ]\n  },\n  {\n   \"dateRanges\": [\n    {\n     \"startDate\": \"{{1.window_start}}\",\n     \"endDate\": \"{{1.window_end}}\"\n    }\n   ],\n   \"dimensions\": [\n    {\n     \"name\": \"sessionDefaultChannelGroup\"\n    }\n   ],\n   \"metrics\": [\n    {\n     \"name\": \"sessions\"\n    },\n    {\n     \"name\": \"keyEvents\"\n    }\n   ],\n   \"orderBys\": [\n    {\n     \"metric\": {\n      \"metricName\": \"sessions\"\n     },\n     \"desc\": true\n    }\n   ],\n   \"limit\": \"15\"\n  },\n  {\n   \"dateRanges\": [\n    {\n     \"startDate\": \"{{1.window_start}}\",\n     \"endDate\": \"{{1.window_end}}\"\n    }\n   ],\n   \"dimensions\": [\n    {\n     \"name\": \"pagePath\"\n    }\n   ],\n   \"metrics\": [\n    {\n     \"name\": \"screenPageViews\"\n    },\n    {\n     \"name\": \"bounceRate\"\n    }\n   ],\n   \"orderBys\": [\n    {\n     \"metric\": {\n      \"metricName\": \"screenPageViews\"\n     },\n     \"desc\": true\n    }\n   ],\n   \"limit\": \"10\"\n  },\n  {\n   \"dateRanges\": [\n    {\n     \"startDate\": \"{{1.window_start}}\",\n     \"endDate\": \"{{1.window_end}}\"\n    }\n   ],\n   \"dimensions\": [\n    {\n     \"name\": \"eventName\"\n    }\n   ],\n   \"metrics\": [\n    {\n     \"name\": \"keyEvents\"\n    }\n   ],\n   \"metricFilter\": {\n    \"filter\": {\n     \"fieldName\": \"keyEvents\",\n     \"numericFilter\": {\n      \"operation\": \"GREATER_THAN\",\n      \"value\": {\n       \"int64Value\": \"0\"\n      }\n     }\n    }\n   },\n   \"limit\": \"20\"\n  }\n ]\n}"
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0,
          "name": "GA4 batchRunReports (5 reports)"
        }
      }
    },
