{
  "functions": {
    "api/social.js": {
      "maxDuration": 60
    },
    "api/cpao.js": {
      "maxDuration": 60,
      "includeFiles": "cpao/assets/**"
    }
  },
  "crons": [
    {
      "path": "/api/cpao",
      "schedule": "0 15 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/pal-email",
      "destination": "/pal-email.html"
    }
  ]
}
